{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionowl.dev/contracts/skill-lab/evaluation-dataset.v1.schema.json",
  "title": "VisionOwl Skill Evaluation Dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "developmentTasks", "validationTasks"],
  "properties": {
    "schemaVersion": { "const": "evaluation-dataset.v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "developmentTasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    },
    "validationTasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement", "baseSha", "requiredRules"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "requirement": { "type": "string", "minLength": 1 },
        "baseSha": { "type": "string", "minLength": 7 },
        "requiredRules": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "criticalRules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowedPaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbiddenPaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metadata": { "type": "object" }
      }
    }
  }
}

