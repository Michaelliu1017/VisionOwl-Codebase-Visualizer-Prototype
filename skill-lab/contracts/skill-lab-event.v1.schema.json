{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionowl.dev/contracts/skill-lab/skill-lab-event.v1.schema.json",
  "title": "VisionOwl Skill Lab Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "occurredAt",
    "projectId",
    "skillId",
    "experimentId",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": "skill-lab-event.v1" },
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": {
      "enum": [
        "skill.evaluation.started",
        "skill.evaluation.completed",
        "skill.optimization.started",
        "skill.optimization.round.completed",
        "skill.optimization.completed",
        "skill.optimization.no_improvement",
        "skill.optimization.failed",
        "skill.version.published",
        "skill.version.rolled_back"
      ]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "projectId": { "type": "string" },
    "skillId": { "type": "string" },
    "experimentId": { "type": "string" },
    "status": { "type": "string" },
    "artifactRefs": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "payload": { "type": "object" }
  }
}
