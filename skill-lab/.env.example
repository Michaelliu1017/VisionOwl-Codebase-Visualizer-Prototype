CORE_BASE_URL=http://cloud:17800
REDIS_URL=redis://redis:6379
INTEGRATION_SERVICE_TOKEN=

# The controller stays inside its own container. Qoder is downgraded to this
# dedicated uid:gid and never receives Core or Bailian credentials.
SKILLLAB_RUNNER_BACKEND=local
SKILLLAB_LOCAL_EXECUTION_USER=10001:10001
QODER_PERSONAL_ACCESS_TOKEN=
SKILLLAB_QODER_MODEL=Performance
SKILLLAB_QODER_MAX_TURNS=25
SKILLLAB_QODER_TIMEOUT_SECONDS=900
SKILLLAB_CHECK_TIMEOUT_SECONDS=120

BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_JUDGE_MODEL=qwen-plus
BAILIAN_OPTIMIZER_MODEL=qwen-plus

SKILLLAB_WORKER_MAX_ROUNDS=2
SKILLLAB_MAX_SKILLS=3
SKILLLAB_MAX_DEVELOPMENT_TASKS=2
SKILLLAB_MAX_VALIDATION_TASKS=1
SKILLOPT_MAX_CHANGES=3
SKILLOPT_WORKERS=1
SKILLLAB_STATE_ROOT=/data/visionowl-skill-lab
