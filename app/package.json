{
  "name": "visionowl-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "VisionOwl 桌面客户端 — 云端代码知识平台",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev --mode production",
    "dev:cloud": "electron-vite dev --mode production",
    "dev:mock": "electron-vite dev --mode mock",
    "dev:renderer": "electron-vite dev --rendererOnly",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "dingtalk-workspace-cli": "^1.0.56",
    "elkjs": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.2.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
