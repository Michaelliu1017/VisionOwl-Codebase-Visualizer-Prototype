{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionowl.local/schemas/sanitized-graph.schema.json",
  "title": "Sanitized Graph Artifact",
  "type": "object",
  "required": ["schemaVersion", "project", "source", "graph"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "project": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["branch", "commit", "generatedAt"],
      "properties": {
        "branch": { "type": "string" },
        "commit": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "required": ["entities", "relations", "executionFlows"],
      "properties": {
        "entities": { "type": "array" },
        "relations": { "type": "array" },
        "executionFlows": { "type": "array" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
