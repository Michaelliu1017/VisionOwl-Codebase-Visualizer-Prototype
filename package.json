{
  "name": "visionowl",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "desktop",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @visionowl/web",
    "dev:api": "npm run dev --workspace @visionowl/api",
    "build": "npm run build --workspace @visionowl/web",
    "test": "npm run test --workspace @visionowl/api && npm run build --workspace @visionowl/web",
    "start": "npm run start --workspace @visionowl/api",
    "desktop": "npm run build && npm run start --workspace @visionowl/desktop"
  },
  "engines": {
    "node": ">=22.5"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.28.1": true
  }
}
