{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionowl.dev/contracts/knowledge.integration.v1.schema.json",
  "title": "VisionOwl Knowledge Generator Integration v1",
  "$defs": {
    "queueMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "runId", "projectId", "idempotencyKey"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "kind": { "const": "knowledge_generate" },
        "runId": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 }
      }
    },
    "repositorySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingId", "repositoryKey", "repoFullName", "branch", "commitSha"],
      "properties": {
        "bindingId": { "type": "string", "minLength": 1 },
        "repositoryKey": { "type": "string", "minLength": 1 },
        "repoFullName": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "branch": { "type": "string", "minLength": 1 },
        "commitSha": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" }
      }
    },
    "command": {
      "type": "object",
      "required": [
        "schemaVersion", "commandId", "idempotencyKey", "deadlineAt", "runId", "projectId",
        "graphVersionId", "graphVersionNo", "graphArtifactKey", "graphDownloadPath", "requestedAssets",
        "repositorySnapshots", "artifactUploadPath", "callbacks"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "commandId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "deadlineAt": { "type": "string", "format": "date-time" },
        "runId": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "graphVersionId": { "type": "string", "minLength": 1 },
        "graphVersionNo": { "type": "integer", "minimum": 1 },
        "graphArtifactKey": { "type": "string", "minLength": 1 },
        "graphDownloadPath": { "type": "string", "minLength": 1 },
        "requestedAssets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["wiki", "skills"] }
        },
        "repositorySnapshots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repositorySnapshot" }
        },
        "artifactUploadPath": { "type": "string", "pattern": "\\{fileName\\}" },
        "callbacks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["progress", "complete", "fail"],
          "properties": {
            "progress": { "type": "string", "minLength": 1 },
            "complete": { "type": "string", "minLength": 1 },
            "fail": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "manifestFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "path", "artifactKey", "mediaType", "size", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "artifactKey": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "title", "files"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "kind": { "enum": ["wiki", "skills"] },
        "title": { "type": "string", "minLength": 1 },
        "files": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/manifestFile" } }
      }
    },
    "publishedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "bundleArtifactKey", "manifestArtifactKey", "checksum", "summary"],
      "properties": {
        "kind": { "enum": ["wiki", "skills"] },
        "bundleArtifactKey": { "type": "string", "minLength": 1 },
        "manifestArtifactKey": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "summary": { "type": "object" }
      }
    }
  }
}
