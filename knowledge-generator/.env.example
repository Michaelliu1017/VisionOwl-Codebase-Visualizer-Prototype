HOST=127.0.0.1
PORT=8091
STORAGE_DRIVER=file
DATA_DIR=./data
DATABASE_URL=postgresql://visionowl:visionowl@127.0.0.1:5432/visionowl_knowledge
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_MAX_CONCURRENCY=3
GITHUB_HISTORY_DAYS=180
GITHUB_MAX_ITEMS=500

# VisionOwl Core integration. Keep false for standalone evidence collection.
KNOWLEDGE_WORKER_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
KNOWLEDGE_STREAM=knowledge:tasks
KNOWLEDGE_CONSUMER_GROUP=knowledge-generators
KNOWLEDGE_CONSUMER_NAME=
KNOWLEDGE_WORKER_CONCURRENCY=1
KNOWLEDGE_CLAIM_IDLE_MS=60000
CORE_BASE_URL=http://127.0.0.1:17800
CORE_SERVICE_TOKEN=
KNOWLEDGE_HISTORY_DAYS=365
KNOWLEDGE_MAX_ITEMS=500
KNOWLEDGE_REPOSITORY_CONCURRENCY=2

# deterministic is the safe fallback; qoder adds evidence-grounded semantic synthesis.
KNOWLEDGE_SEMANTIC_PROVIDER=deterministic
KNOWLEDGE_SEMANTIC_REQUIRED=false
QODER_CLI_PATH=qodercli
QODER_KNOWLEDGE_MODEL=Performance
QODER_KNOWLEDGE_TIMEOUT_SECONDS=600
QODER_KNOWLEDGE_MAX_OUTPUT_TOKENS=12000
