{
  "name": "visionowl-cloud",
  "version": "0.1.0",
  "packageManager": "pnpm@11.20.0",
  "private": true,
  "description": "VisionOwl Cloud API + Worker (contract-v1.0)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker/index.js",
    "migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "seed": "tsx src/seed/seed.ts",
    "seed:prod": "node dist/seed/seed.js",
    "scan": "tsx src/scanner/cli.ts",
    "verify:fixture": "tsx src/seed/verifyFixture.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts src/services/*.test.ts src/scanner/*.test.ts",
    "check": "npm run typecheck && npm run test && npm run verify:fixture"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "ajv": "^8.17.1",
    "ali-oss": "^6.23.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "typescript": "^5.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1"
  }
}
