# ── VisionOwl Cloud API / Worker 环境变量 ─────────────────────────────
# 复制为 .env 后填值；.env 绝不入库(见 .gitignore)

# —— 基础 ——
NODE_ENV=development
PORT=17800
LOG_LEVEL=info
# 客户端可访问的对外地址(GitHub App 回调、install-url state 用)
PUBLIC_BASE_URL=http://114.55.60.94:8080
# MVP 允许 *(Electron 渲染层 origin 不固定)，安全靠 Bearer + 登录限速
CORS_ORIGIN=*

# —— 数据面 ——
DATABASE_URL=postgres://visionowl:CHANGE_ME@postgres:5432/visionowl
REDIS_URL=redis://redis:6379
# 图谱产物目录(local 模式使用；oss 模式不落本地源码产物)
ARTIFACTS_DIR=/data/artifacts
# local=开发磁盘；oss=生产对象存储
ARTIFACT_STORAGE=local
OSS_REGION=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_STS_TOKEN=

# —— 认证 ——
# 32 字节随机串：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_BYTES_MIN
JWT_TTL_DAYS=7
# 登录限速：次数 / 时间窗
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW=1 minute
# AI 对话限速(每用户)
CHAT_RATE_MAX=20
CHAT_RATE_WINDOW=1 minute
# 同 commit、模块与问题的 Qoder 回答缓存（固定快捷问题可直接复用）
CHAT_ANSWER_CACHE_TTL_SECONDS=86400

# —— Knowledge Generator / Skill Lab 集成 ——
# Core 与两个扩展模块之间的服务身份；生产环境至少 32 字节。
# 可选扩展。未部署 Knowledge Generator / Skill Lab 时保持 false，Core 原有功能照常运行。
KNOWLEDGE_INTEGRATION_ENABLED=false
INTEGRATION_SERVICE_TOKEN=
# 扩展模块经 Core 上传单个产物的最大字节数。
INTEGRATION_ARTIFACT_MAX_BYTES=26214400
# Core 重新投递未确认任务的巡检周期。
INTEGRATION_DISPATCH_INTERVAL_SECONDS=30
KNOWLEDGE_RUN_TIMEOUT_SECONDS=1800
SKILLLAB_RUN_TIMEOUT_SECONDS=3600
# 首次上线先设为 false，手工联调通过后再开启图谱发布自动触发。
KNOWLEDGE_AUTO_GENERATE=false
SKILLLAB_AUTO_OPTIMIZE=false
SKILLLAB_EVALUATION_DATASET_REF=project-history:v1
SKILLLAB_MAX_ROUNDS=5
SKILLLAB_MAX_PATCHES_PER_ROUND=3
SKILLLAB_SOURCE_ARCHIVE_MAX_BYTES=104857600

# —— 任务队列 ——
# 同分支连续 push 的去抖窗口(秒)
JOB_DEBOUNCE_SECONDS=30
# Worker 并发上限（当前 ECS 16G 环境压测值：3）
WORKER_CONCURRENCY=3
# 单仓库扫描子任务最多尝试次数；成功仓库不会因其它仓库失败而重复扫描
REPOSITORY_SCAN_MAX_ATTEMPTS=3
# 单任务硬超时(秒)：全量 / 增量
JOB_TIMEOUT_FULL=1200
JOB_TIMEOUT_INCREMENTAL=600

# —— 分析器模式 ——
# demo   : 不克隆仓库，复用 seed 演示图谱(冒烟用，零依赖)
# local  : 宿主机 git clone + 确定性扫描器(无 Agent，零 credit，可离线验收 §14-2/5/6/7)
# runner : 完整两段式，Docker 拉起一次性 Runner 容器(需 ACR + qodercli PAT)
ANALYZER_MODE=demo
RUNNER_IMAGE=visionowl-runner:latest
RUNNER_NETWORK=runner-net
# 并行模块 Agent 默认仍沿用现有资源限制；压测通过后可提升到 8g / 4 CPU
RUNNER_MEMORY=4g
RUNNER_CPUS=2
# Runner 工作区(宿主机路径，必须与 worker 容器挂载一致)
WORKSPACE_DIR=/data/workspace
# 当前 commit 源码短期缓存；仅供隔离 Runner 只读挂载，过期自动删除
SOURCE_CACHE_TTL_SECONDS=86400
# Agent turn 上限(成本铁律：全量 50 / 增量 25)
MAX_TURNS_FULL=50
MAX_TURNS_INCREMENTAL=25

# —— P2 起用：GitHub App ——
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# —— P2 起用：Qoder(仅 worker/runner 需要，禁止写入镜像层) ——
QODER_PERSONAL_ACCESS_TOKEN=
# adaptive：默认。普通仓库单 Agent，大仓库少量并行 Agent，由代码合并 Patch；不运行重型全局汇总。
# legacy_multi：保留原有“模块 Agent + 全局 Agent 汇总”流程，便于回退和对照实验。
AGENT_ORCHESTRATION_MODE=adaptive
QODER_MODULE_MODEL=Performance
QODER_SYNTHESIS_MODEL=Performance
QODER_SYNTHESIS_MAX_TURNS=12
# adaptive 模式的规模阈值。分析包不超过 8 个时只启动 1 个 Agent。
ADAPTIVE_SINGLE_AGENT_MAX_PACKETS=8
ADAPTIVE_MAX_AGENTS=4
ADAPTIVE_PACKETS_PER_AGENT=5
# 同一 Runner 内的并行度与调用数量上限；模块过多时会合并相关分析包，不会丢模块
MODULE_AGENT_CONCURRENCY=3
MODULE_AGENT_MAX_TASKS=24
MODULE_AGENT_TIMEOUT_SECONDS=300
MODULE_AGENT_MAX_OUTPUT_TOKENS=4000
MODULE_AGENT_CONTEXT_MAX_BYTES=60000
MODULE_AGENT_CONTEXT_MAX_FILES=24
MODULE_AGENT_REPAIR_ENABLED=true
# Empty means reuse QODER_MODULE_MODEL. Repair only reshapes the first answer.
QODER_MODULE_REPAIR_MODEL=
MODULE_AGENT_REPAIR_MAX_OUTPUT_TOKENS=4000
MODULE_AGENT_REPAIR_MAX_CANDIDATE_BYTES=60000
# 当前 Qoder 账号已开放的低延迟模型
QODER_CHAT_MODEL=DeepSeek-V4-Flash
QODER_CHAT_MAX_TURNS=5
QODER_CHAT_MAX_OUTPUT_TOKENS=1200
# 队列等待与 Qoder 推理使用独立预算；ECS 到 Qoder 的单轮响应实测可能超过 75 秒
QODER_CHAT_QUEUE_TIMEOUT_SECONDS=120
QODER_CHAT_TIMEOUT_SECONDS=240

# —— 钉钉 DWS：每个 VisionOwl 用户独立加密登录态 ——
DWS_CLI_PATH=dws
DWS_CREDENTIALS_DIR=/data/dws
DWS_COMMAND_TIMEOUT_SECONDS=180
